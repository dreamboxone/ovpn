#
# ovpn-update - refresh the server list and pick the fastest one.
#
# The measurement is a real proxied HTTP request through each candidate, timed
# end to end. Not ICMP, not a TCP handshake: a server can answer both of those
# in 30 ms and still be unusable, because what gets throttled here is the
# request that follows. Only a request that completes proves a route works.
#
#   ovpn-update           refresh the list, then test and select
#   ovpn-update test      test the list we already have
#   ovpn-update fetch     refresh the list only

set -e

STATE_DIR=/var/run/ovpn
LIST=/etc/ovpn/servers.list          # survives reboots, so a boot needs no fetch
CAND="$STATE_DIR/candidates.tsv"
# The selection lives beside the list, not in /var/run: that is tmpfs, so
# a reboot would throw it away and the tunnel could not come back without
# measuring a hundred servers first.
BEST=/etc/ovpn/best.json
BEST_META=/etc/ovpn/best.meta
RESULTS="$STATE_DIR/results.tsv"
ATTEMPTS="$STATE_DIR/attempts"
STAMP=/etc/ovpn/last-update
COMMON=/usr/libexec/ovpn-common.sh
PARSE=/usr/libexec/ovpn-parse

. "$COMMON"

# Where the servers come from. Deliberately kept here and nowhere else - not in
# UCI, not in the web interface, not in the documentation.
SUB_URL="https://raw.githubusercontent.com/0xRadikal/Free-v2ray-Configs/main/top100.txt"

# What a test request is measured against. Small, fast, unauthenticated, and
# reachable without the tunnel: a 204 with no body means the whole path worked.
TEST_URL="http://www.gstatic.com/generate_204"
TEST_TIMEOUT=6
# `wait` waits for the whole batch, so a batch costs whatever its slowest
# member costs - and on a filtered line most members spend the full timeout.
# Fewer, larger batches is therefore the whole difference between half a
# minute and a minute. The processes are almost entirely idle, waiting.
TEST_PARALLEL=25
BASE_PORT=24000

log() { logger -t ovpn "$*"; [ -t 1 ] && echo "$*" >&2 || true; }

mkdir -p "$STATE_DIR" /etc/ovpn

cmd_fetch() {
	tmp="$STATE_DIR/list.new"
	if ! curl -fsSL --connect-timeout 15 --max-time 60 -o "$tmp" "$SUB_URL" 2>/dev/null; then
		log "server list download failed"
		[ -s "$LIST" ] && { log "keeping the list already on disk"; return 0; }
		return 1
	fi
	# a truncated or hijacked answer must never replace a working list
	if [ "$(wc -c < "$tmp")" -lt 500 ]; then
		log "server list looks truncated - keeping the old one"
		rm -f "$tmp"
		[ -s "$LIST" ] && return 0
		return 1
	fi
	mv -f "$tmp" "$LIST"
	date -u +%s > "$STAMP"
	log "server list refreshed"
}

cmd_parse() {
	[ -s "$LIST" ] || { log "no server list yet"; return 1; }
	awk -f "$PARSE" < "$LIST" > "$CAND.new" 2>/dev/null || true
	if [ ! -s "$CAND.new" ]; then
		log "no usable servers in the list"
		rm -f "$CAND.new"
		return 1
	fi
	mv -f "$CAND.new" "$CAND"
	log "$(wc -l < "$CAND") servers to test"
	echo "selecting" > "$STATE_DIR/status" 2>/dev/null || true
}

# Build one xray instance holding every candidate at once, each behind its own
# local SOCKS port. Starting a hundred processes would take longer than the
# test; one process with a hundred inbounds costs almost nothing.
build_test_config() {
	out="$STATE_DIR/test.json"
	{
		printf '{"log":{"loglevel":"none"},"inbounds":['
		i=0
		while IFS="	" read -r tag label json; do
			[ -n "$tag" ] || continue
			[ "$i" -gt 0 ] && printf ','
			printf '{"tag":"in_%s","listen":"127.0.0.1","port":%d,"protocol":"socks","settings":{"udp":false}}' \
				"$tag" $((BASE_PORT + i))
			i=$((i + 1))
		done < "$CAND"
		printf '],"outbounds":['
		i=0
		while IFS="	" read -r tag label json; do
			[ -n "$tag" ] || continue
			[ "$i" -gt 0 ] && printf ','
			printf '%s' "$(echo "$json" | sed "s/^{/{\"tag\":\"$tag\",/")"
			i=$((i + 1))
		done < "$CAND"
		printf '],"routing":{"rules":['
		i=0
		while IFS="	" read -r tag label json; do
			[ -n "$tag" ] || continue
			[ "$i" -gt 0 ] && printf ','
			printf '{"type":"field","inboundTag":["in_%s"],"outboundTag":"%s"}' "$tag" "$tag"
			i=$((i + 1))
		done < "$CAND"
		printf ']}}'
	} > "$out"
	echo "$out"
}

cmd_test() {
	[ -s "$CAND" ] || cmd_parse || return 1

	# A test instance left behind by an interrupted run still holds every one
	# of these ports. The next run then cannot bind, every measurement fails,
	# and the answer is "no server responded" for good - a failure that keeps
	# itself alive and looks like the network.
	kill $(pgrep -f "run -config $STATE_DIR/test.json") 2>/dev/null || true
	sleep 1

	cfg="$(build_test_config)"
	XRAY="$(find_xray "$cfg")" || {
		log "no xray on this router can run the generated configuration"
		return 1
	}

	"$XRAY" run -config "$cfg" >/dev/null 2>&1 &
	xpid=$!
	# and this run must not leave one behind either, however it ends
	trap 'kill "$xpid" 2>/dev/null; rm -f "$cfg"' EXIT INT TERM
	# give the listeners a moment; without this the first few candidates
	# would be scored on xray's startup rather than on their own latency
	sleep 2

	if ! kill -0 "$xpid" 2>/dev/null; then
		log "the test instance did not start - ports busy, or a bad server entry"
		return 1
	fi

	: > "$RESULTS"
	: > "$ATTEMPTS"
	i=0
	running=0
	pids=""
	while IFS="	" read -r tag label json; do
		[ -n "$tag" ] || continue
		port=$((BASE_PORT + i))
		i=$((i + 1))
		(
			# curl only exits 0 when the whole request completed, so a
			# non-zero exit is exactly the "this route does not work"
			# signal we want - no need to inspect the status code as well
			if ms=$(curl -s -o /dev/null \
				-x "socks5h://127.0.0.1:$port" \
				--connect-timeout "$TEST_TIMEOUT" --max-time "$TEST_TIMEOUT" \
				-w '%{time_total}' "$TEST_URL" 2>/dev/null)
			then
				printf '%s\t%s\t%s\n' \
					"$(awk -v t="$ms" 'BEGIN{printf "%d", t*1000}')" \
					"$tag" "$label" >> "$RESULTS"
			fi
			# one line per server tried, whatever the outcome: this is what the
			# progress bar counts
			echo x >> "$ATTEMPTS"
		) &
		pids="$pids $!"
		running=$((running + 1))
		# Wait for these children by name, never a bare `wait`: xray is a
		# background job of this same shell, so a bare wait sits on it until it
		# exits - which it never does. That stopped the whole selection dead at
		# the first batch boundary, and looked exactly like finding nothing.
		if [ "$running" -ge "$TEST_PARALLEL" ]; then
			for _p in $pids; do wait "$_p" 2>/dev/null || true; done
			pids=""; running=0
		fi
	done < "$CAND"
	for _p in $pids; do wait "$_p" 2>/dev/null || true; done

	# A measurement is only worth its result if the thing doing the measuring
	# lasted through it. A hundred inbounds and twenty-five requests at once
	# is real work for a router, and if the test instance dies part way the
	# rest of the list fails for a reason that has nothing to do with those
	# servers - and we would quietly pick from whatever answered before it
	# went, believing the other ninety-odd unreachable.
	if ! kill -0 "$xpid" 2>/dev/null; then
		log "the test instance did not survive the measurement - $(wc -l < "$RESULTS") of $(wc -l < "$CAND") answered before it went, so those counts mean little"
	fi

	kill "$xpid" 2>/dev/null || true
	wait "$xpid" 2>/dev/null || true

	if [ ! -s "$RESULTS" ]; then
		log "no server answered a test request"
		return 1
	fi

	# lowest measured round trip wins
	best="$(sort -n "$RESULTS" | head -1)"
	bms="${best%%	*}"
	rest="${best#*	}"
	btag="${rest%%	*}"
	blabel="${rest#*	}"

	awk -F'\t' -v t="$btag" '$1==t {print $3; exit}' "$CAND" > "$BEST"
	[ -s "$BEST" ] || { log "selected server vanished from the list"; return 1; }

	printf 'tag=%s\nlabel=%s\nlatency_ms=%s\ntested=%s\ntotal=%s\nalive=%s\n' \
		"$btag" "$blabel" "$bms" "$(date -u +%s)" \
		"$(wc -l < "$CAND")" "$(wc -l < "$RESULTS")" > "$BEST_META"

	log "selected $blabel at ${bms}ms ($(wc -l < "$RESULTS") of $(wc -l < "$CAND") servers answered)"
}

case "${1:-update}" in
	fetch)  cmd_fetch ;;
	parse)  cmd_parse ;;
	test)   cmd_test ;;
	update) cmd_fetch || true; cmd_parse && cmd_test ;;
	*) echo "usage: $0 update|fetch|parse|test" >&2; exit 1 ;;
esac
