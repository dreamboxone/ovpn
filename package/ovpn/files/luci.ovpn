#!/bin/sh
#
# SPDX-License-Identifier: GPL-3.0-only
# Copyright (C) 2026 dreamboxone <https://t.me/routekernel1>
# Part of ovpn - https://github.com/dreamboxone/ovpn
#
# rpcd backend for luci-app-ovpn (ubus object: luci.ovpn)

. /usr/share/libubox/jshn.sh

STATE_DIR=/var/run/ovpn
BEST_META=/etc/ovpn/best.meta
CONNECT=/usr/libexec/ovpn-connect
STATUS="$STATE_DIR/status"

meta_get() {
	sed -n "s/^$1=//p" "$BEST_META" 2>/dev/null | tail -1
}

num() {
	case "$1" in
		''|*[!0-9]*) echo 0 ;;
		*) echo "$1" ;;
	esac
}

is_running() {
	# match on the configuration, so this holds whichever xray was chosen
	pgrep -f "run -config /var/etc/ovpn.json" >/dev/null 2>&1
}

# The subscription carries the channel it came from inside every server name.
# That belongs nowhere near the interface, so keep the country and drop the
# rest rather than trusting the list to stay tidy.
server_label() {
	meta_get label | awk '{
		sub(/[|@].*/, "")
		gsub(/^[ \t]+|[ \t]+$/, "")
		print
	}'
}

# Run something without holding this request open: rpcd reads our stdout until
# every writer closes it, so a child that keeps it would hang the browser call
# however fast we answer.
detach() {
	if command -v setsid >/dev/null 2>&1; then
		setsid "$@" </dev/null >/dev/null 2>&1 &
	else
		( "$@" </dev/null >/dev/null 2>&1 & ) &
	fi
	return 0
}

method_state() {
	local running=0 connected=0 enabled autostart

	is_running && running=1
	[ "$running" = "1" ] && [ -s /etc/ovpn/best.json ] && connected=1

	enabled=$(uci -q get ovpn.config.enabled)
	[ "$enabled" = "1" ] && enabled=1 || enabled=0

	# what `/etc/init.d/ovpn enabled` tests, done inline so a busy procd can
	# never hold this request open
	autostart=0
	for l in /etc/rc.d/S??ovpn; do
		[ -L "$l" ] && autostart=1
	done

	json_init
	json_add_string "version" "1.0.1"
	json_add_boolean "running" "$running"
	json_add_boolean "connected" "$connected"
	json_add_boolean "enabled" "$enabled"
	json_add_boolean "autostart" "$autostart"
	json_add_string "status" "$(cat "$STATUS" 2>/dev/null)"
	json_add_string "server" "$(server_label)"
	json_add_int "latency_ms" "$(num "$(meta_get latency_ms)")"
	# Live counts, so the page can show real progress rather than a timer
	# that guesses. total is how many servers there are to try, tried is how
	# many have been answered for either way.
	json_add_int "total" "$(num "$(wc -l < "$STATE_DIR/candidates.tsv" 2>/dev/null | tr -d " ")")"
	json_add_int "tried" "$(num "$(wc -l < "$STATE_DIR/attempts" 2>/dev/null | tr -d " ")")"
	json_add_int "answered" "$(num "$(wc -l < "$STATE_DIR/results.tsv" 2>/dev/null | tr -d " ")")"
	json_add_int "alive" "$(num "$(meta_get alive)")"
	json_add_int "now" "$(date +%s)"
	json_dump
}

method_action() {
	local name input

	read -r input
	[ -n "$input" ] || input='{}'
	json_load "$input" 2>/dev/null
	json_get_var name name

	case "$name" in
		connect)
			uci -q set ovpn.config.enabled='1' && uci -q commit ovpn
			echo selecting > "$STATUS" 2>/dev/null
			detach "$CONNECT"
			;;
		prepare)
			# The page was opened. Measure now so that pressing Connect is
			# instant, but only when there is nothing to use yet - opening a
			# page must never disturb a tunnel that is already running.
			# Say so here, not in the detached script: between forking and
			# that script's first write there is a gap, and through the whole
			# gap the page would still be showing whatever the last attempt
			# ended as - which reads as a page that opened and did nothing.
			if [ ! -s /etc/ovpn/best.json ]; then
				echo selecting > "$STATUS" 2>/dev/null
				detach "$CONNECT" prepare
			fi
			;;
		disconnect)
			uci -q set ovpn.config.enabled='0' && uci -q commit ovpn
			rm -f "$STATUS"
			detach timeout 30 /etc/init.d/ovpn stop
			;;
		*)
			json_init
			json_add_boolean "ok" 0
			json_add_string "error" "unknown action"
			json_dump
			return
			;;
	esac

	json_init
	json_add_boolean "ok" 1
	json_dump
}

case "$1" in
	list)
		json_init
		json_add_object "state";  json_close_object
		json_add_object "action"; json_add_string "name" ""; json_close_object
		json_dump
		;;
	call)
		case "$2" in
			state)  method_state ;;
			action) method_action ;;
		esac
		;;
esac
