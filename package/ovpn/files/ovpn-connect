#
# ovpn-connect - choose a server, and optionally connect through it.
#
#   ovpn-connect            select, then start the tunnel   (the Connect button)
#   ovpn-connect prepare    select only                     (the page was opened)
#   ovpn-connect force      measure again first             (the refresh, healing)
#
# Choosing means a timed request through each of a hundred servers, which
# takes about half a minute. That cannot happen inside start_service: procd
# would be held for the whole measurement, and the service it is starting
# would be neither started nor failed while it waited.

set -e

STATE_DIR=/var/run/ovpn
STATUS="$STATE_DIR/status"
LOCK="$STATE_DIR/lock"
BEST=/etc/ovpn/best.json
UPDATE=/usr/libexec/ovpn-update

MODE="${1:-connect}"

mkdir -p "$STATE_DIR"

# The interface reads this. Without it the whole selection looks to a user
# exactly like a button that did nothing.
say() { echo "$1" > "$STATUS"; }

# mkdir is atomic, so two page loads at once cannot both start measuring.
if ! mkdir "$LOCK" 2>/dev/null; then
	# A stale directory would wedge this for good, so only respect a lock
	# that something is actually holding.
	if [ -f "$LOCK/pid" ] && kill -0 "$(cat "$LOCK/pid" 2>/dev/null)" 2>/dev/null; then
		exit 0
	fi
	rm -rf "$LOCK"
	mkdir "$LOCK" 2>/dev/null || exit 0
fi
echo $$ > "$LOCK/pid"

cleanup() { rm -rf "$LOCK"; }
trap 'say failed; cleanup' INT TERM
trap cleanup EXIT

# Opening the page must not throw away a selection that is already good, and
# must never disturb a tunnel that is already up.
if [ "$MODE" = "prepare" ] && [ -s "$BEST" ]; then
	exit 0
fi

# Opening the page measures; pressing Connect then finds the answer already
# there. Measuring again would make the reader wait a second half minute for
# a result that has not had time to change, which is the whole point of doing
# it when the page opened.
FRESH_SECONDS=3600
fresh=0
if [ -s "$BEST" ]; then
	age=$(( $(date +%s) - $(date -r "$BEST" +%s 2>/dev/null || echo 0) ))
	# an `a && b && c` line is a trap under set -e: when the test is false the
	# line returns non-zero and takes the whole script with it
	if [ "$age" -ge 0 ] && [ "$age" -lt "$FRESH_SECONDS" ]; then
		fresh=1
	fi
fi

# The refresh calls this when the tunnel should be up and is not, which means
# the server we picked has stopped working. Reusing that pick is the one thing
# that cannot help.
if [ "$MODE" = "force" ]; then
	fresh=0
fi

if [ "$fresh" = "1" ]; then
	say starting
else
	say selecting
	if ! "$UPDATE" update >/dev/null 2>&1; then
		say failed
		exit 0
	fi
fi

if [ "$MODE" = "prepare" ]; then
	# ready to connect, but nothing is running and nothing was changed
	say idle
	exit 0
fi

if timeout 60 /etc/init.d/ovpn restart >/dev/null 2>&1; then
	# autostart was a setting nothing read: the boot symlink was never made,
	# so the tunnel could not come back after a power cut whatever it said.
	# Done here rather than inside the init script, which would be asking the
	# init script to run itself and wait on a lock it is already holding.
	if [ "$(uci -q get ovpn.config.autostart)" = "1" ]; then
		timeout 15 /etc/init.d/ovpn enable >/dev/null 2>&1 || true
	else
		timeout 15 /etc/init.d/ovpn disable >/dev/null 2>&1 || true
	fi
	say ready
else
	# A failed start must not leave the network pointing at a tunnel that
	# is not there. Better disconnected than unreachable.
	/usr/libexec/ovpn-rules down >/dev/null 2>&1 || true
	say failed
fi
