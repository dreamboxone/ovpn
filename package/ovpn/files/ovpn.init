#!/bin/sh /etc/rc.common
#
# SPDX-License-Identifier: GPL-3.0-only
# Copyright (C) 2026 dreamboxone <https://t.me/routekernel1>
# Part of ovpn - https://github.com/dreamboxone/ovpn

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/xray
UPDATE=/usr/libexec/ovpn-update
MKCONFIG=/usr/libexec/ovpn-mkconfig
RULES=/usr/libexec/ovpn-rules
CONFIG_JSON=/var/etc/ovpn.json
STATE_DIR=/var/run/ovpn

start_service() {
	local enabled

	config_load ovpn
	config_get_bool enabled config enabled 0
	if [ "$enabled" != "1" ]; then
		logger -t ovpn "not starting: press Connect first"
		return 0
	fi

	[ -x "$PROG" ] || { logger -t ovpn "xray is missing"; return 1; }

	mkdir -p "$STATE_DIR" /var/etc /etc/ovpn

	# No server picked yet, or the pick is from a previous boot: choose one
	# before starting. Detached, because this takes as long as a hundred
	# timed requests and a service start must not block on the network.
	if [ ! -s "$STATE_DIR/best.json" ]; then
		logger -t ovpn "no server selected yet - selecting"
		"$UPDATE" update >/dev/null 2>&1 || {
			logger -t ovpn "could not select a server"
			return 1
		}
	fi

	if ! "$MKCONFIG" > "$CONFIG_JSON"; then
		logger -t ovpn "could not write $CONFIG_JSON"
		return 1
	fi
	chmod 600 "$CONFIG_JSON"

	if ! "$PROG" run -test -config "$CONFIG_JSON" >/dev/null 2>&1; then
		logger -t ovpn "xray rejected the generated configuration"
		return 1
	fi

	procd_open_instance ovpn
	procd_set_param command "$PROG" run -config "$CONFIG_JSON"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/ovpn.pid
	procd_close_instance

	# rules last: with them up and xray not yet listening, the LAN would have
	# no way out at all
	"$RULES" up >/dev/null 2>&1 || logger -t ovpn "could not install the routing rules"
}

stop_service() {
	"$RULES" down >/dev/null 2>&1 || true
	rm -f "$CONFIG_JSON"
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger "ovpn"
}
